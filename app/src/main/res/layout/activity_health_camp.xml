            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Sadhyasathi ekch card multiple vela include karu shakta -->
            <include layout="@layout/item_health_camp" />
            <include layout="@layout/item_health_camp" />
            <include layout="@layout/item_health_camp" />
            <include layout="@layout/item_health_camp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>