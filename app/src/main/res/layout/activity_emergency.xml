<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#222222"
            android:textSize="35sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Emergency SOS"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="45dp"
            android:layout_height="45dp" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sosButton"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:background="@drawable/sos_circle"

            android:gravity="center"
            android:text="SOS\nPRESS HERE"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Your current location will be\nshared with your emergency contacts."
            android:textColor="#777777"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- Emergency Contacts -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Emergency Contacts"
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold" />


    <!-- Mom -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="👩"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mom"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 98765 43210"
                android:textColor="#777777"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/callMom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Call Mom"
            android:src="@android:drawable/ic_menu_call" />

    </LinearLayout>


    <!-- Dad -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="👨"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dad"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 91234 56789"
                android:textColor="#777777"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/callDad"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Call Dad"
            android:src="@android:drawable/ic_menu_call" />

    </LinearLayout>


    <!-- Best Friend -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="👩"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Best Friend"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 99876 87655"
                android:textColor="#777777"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/callFriend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Call Friend"
            android:src="@android:drawable/ic_menu_call" />

    </LinearLayout>


    <!-- Find Hospital -->

    <Button
        android:id="@+id/findHospitalButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#E53935"
        android:text="📍  Find Nearby Hospital"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>